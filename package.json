{
  "name": "offline-signer-cli",
  "version": "1.0.0",
  "description": "Offline Solana transaction signing CLI. The cold wallet signs a 32-byte digest, never a full transaction.",
  "bin": {
    "offline-signer": "dist/bundle.js",
    "offline-signer-cli": "dist/bundle.js"
  },
  "scripts": {
    "build:ts": "tsc",
    "build:bundle": "esbuild dist/index.js --bundle --minify --platform=node --target=node18 --outfile=dist/bundle.js --format=cjs",
    "build": "pnpm build:ts && pnpm build:bundle",
    "start": "node dist/bundle.js",
    "dev": "ts-node src/index.ts",
    "anchor:build": "anchor build",
    "anchor:test": "anchor test",
    "build:binaries": "pnpm build && pkg dist/bundle.js --output dist/executables/offline-signer",
    "prepublishOnly": "pnpm exec tsc --noEmit && pnpm build"
  },
  "keywords": [
    "solana",
    "offline-signing",
    "cold-wallet",
    "air-gapped",
    "ed25519",
    "anchor",
    "staking",
    "governance"
  ],
  "author": "",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.14.0",
  "dependencies": {
    "@coral-xyz/anchor": "^0.32.1",
    "@solana/spl-governance": "^0.3.28",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4",
    "tweetnacl": "^1.0.3",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@types/bn.js": "^5.1.6",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.8.1",
    "@types/yargs": "^17.0.33",
    "@yao-pkg/pkg": "^6.6.0",
    "chai": "^4.5.0",
    "esbuild": "^0.24.0",
    "mocha": "^10.7.0",
    "ts-mocha": "^10.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "overrides": {
      "chalk": "4.1.2"
    }
  },
  "pkg": {
    "scripts": "dist/bundle.js",
    "outputPath": "dist/executables"
  },
  "files": [
    "dist/bundle.js",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kym0211/offline-signer-cli.git"
  }
}
