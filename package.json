{
  "name": "offline-signer-cli",
  "version": "1.0.0",
  "description": "A CLI tool for offline Solana transaction signing.",
  "bin": {
    "offline-signer-cli": "dist/bundle.js"
  },
  "scripts": {
    "build:ts": "tsc",
    "build:bundle": "esbuild dist/index.js --bundle --minify --platform=node --target=node18 --outfile=dist/bundle.js --format=cjs",
    "build": "pnpm build:ts && pnpm build:bundle && pkg .",
    "start": "node dist/bundle.js",
    "dev": "ts-node src/index.ts",
    "anchor:build": "anchor build",
    "anchor:test": "anchor test"
  },
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.14.0",
  "dependencies": {
    "@coral-xyz/anchor": "^0.32.1",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4",
    "tweetnacl": "^1.0.3",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@types/bn.js": "^5.1.6",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.8.1",
    "@types/yargs": "^17.0.33",
    "chai": "^4.5.0",
    "esbuild": "^0.24.0",
    "mocha": "^10.7.0",
    "pkg": "^5.8.1",
    "ts-mocha": "^10.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "overrides": {
      "chalk": "4.1.2"
    }
  },
  "pkg": {
    "scripts": "dist/bundle.js",
    "targets": [
      "node18-win-x64",
      "node18-macos-x64",
      "node18-linux-x64"
    ],
    "outputPath": "dist/executables"
  }
}