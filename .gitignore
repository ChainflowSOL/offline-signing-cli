# -----------------------------
# Node.js
# -----------------------------
node_modules
.yarn
# pnpm-lock.yaml is deliberately committed. It pins every transitive
# dependency to an exact version + integrity hash, which is what makes
# `pnpm install --frozen-lockfile` reproducible and what stops a
# compromised transitive package reaching a release binary. CI also
# needs it for setup-node's pnpm cache. Do not re-add it here.

# -----------------------------
# Rust / Anchor
# -----------------------------
.anchor
target/
test-ledger/
**/*.rs.bk

# -----------------------------
# Compiled Output
# -----------------------------
# Your TypeScript build output
dist/

# Standalone Executables from 'pkg'
*.exe
*.dmg
*.bin

# -----------------------------
# User-Generated Files
# -----------------------------
# These files are generated by your tool, so ignore them.
cold-wallet.json
unsigned-tx.json
signed-tx.json
signature.json
nonce-address.json
vector-info.json
# Keep the test scripts in smoke/, ignore only the throwaway cold keypair.
smoke/cold-test.json
smoke/hot-test.json

